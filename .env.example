# Copy to .env.local for development. NEVER commit real values.
# These configure the DEPLOYMENT (one set per environment). Organization-specific
# settings (name, branding, onboarding policy, email domains) live in the database.

# development | staging | production
APP_ENV=development
# Public origin used for auth email and OAuth callbacks. Set to your deployed HTTPS URL.
APP_URL=http://localhost:3000

# --- Supabase (Dashboard > Project Settings > API) -----------------------------
# Public values: shipped to the browser, inlined at build time. Every request
# they make is still subject to row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Database (server only) ------------------------------------------------------
# Use the TRANSACTION pooler (port 6543). The app switches to the `authenticated`
# role inside each transaction, so RLS applies to its queries. In production,
# connect as a dedicated low-privilege login role (see docs/DEPLOYMENT.md), not
# as `postgres`.
DATABASE_URL=postgresql://clubsphere_app.your-project-ref:replace_me@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# debug | info | warn | error
LOG_LEVEL=info

# --- Not used by the running app --------------------------------------------------
# The service-role key bypasses RLS. ClubSphere's request handling never uses it.
# Keep it only in your password manager / CI secret store for admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: real Postgres for test/concurrency (e.g. local `supabase start`).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
